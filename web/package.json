{
  "name": "graphwan-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "demo": "vite --config vite.demo.config.ts --host 0.0.0.0 --port 5174 --strictPort",
    "demo:setup": "node scripts/demo-geoip.mjs",
    "demo:build": "tsc -b && vite build --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts --host 0.0.0.0 --port 5174 --strictPort",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/licenses.mjs",
    "format": "prettier --write src scripts *.ts *.json index.html",
    "format:check": "prettier --check src scripts *.ts *.json index.html"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "maxmind": "^5.0.7",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
