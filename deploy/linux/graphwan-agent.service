[Unit]
Description=GraphWAN network agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
StateDirectory=graphwan-agent
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/graphwan/agent.env
ExecStart=/usr/local/bin/graphwan agent --data-dir /var/lib/graphwan-agent --server ${GRAPHWAN_SERVER} --ca ${GRAPHWAN_CA} --name ${GRAPHWAN_NAME}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
# The agent must see the host network and its TUN device. Do not enable
# PrivateNetwork, PrivateDevices or PrivateUsers for this unit.

[Install]
WantedBy=multi-user.target
