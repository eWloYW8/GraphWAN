# systemd EnvironmentFile syntax, not a shell script. No export or substitution.
GRAPHWAN_LISTEN=0.0.0.0:8443
GRAPHWAN_TLS_HOSTS=controller.example.com
# Set a unique password before first start. Remove this line after initialization.
GRAPHWAN_ADMIN_PASSWORD=replace-before-first-start
# Optional city MMDB for offline GeoIP; otherwise downloaded on first use.
# GRAPHWAN_GEOIP_DB=/var/lib/graphwan/GeoLite2-City.mmdb
