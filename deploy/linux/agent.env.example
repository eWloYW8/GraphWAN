# Copy the controller's public ca.pem to GRAPHWAN_CA using a trusted channel.
GRAPHWAN_SERVER=https://controller.example.com:8443
# Controller carrier: tcp (default), websocket, grpc or wss.
GRAPHWAN_SERVER_TRANSPORT=tcp
GRAPHWAN_CA=/etc/graphwan/ca.pem
GRAPHWAN_NAME=linux-node
# Generate a one-time token in the UI. Remove this line after enrollment.
GRAPHWAN_ENROLLMENT_TOKEN=replace-before-first-start
